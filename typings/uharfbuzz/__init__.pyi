# The slice of uharfbuzz that nmsu.layout uses. uharfbuzz ships no type
# information; extend this when the toolkit starts calling more of it.
from collections.abc import Mapping

class Blob:
    @classmethod
    def from_file_path(cls, filename: str) -> Blob: ...

class Face:
    def __init__(self, blob: Blob, index: int = ...) -> None: ...
    @property
    def upem(self) -> int: ...

class Font:
    def __init__(self, face: Face) -> None: ...

class GlyphPosition:
    @property
    def x_advance(self) -> int: ...

class Buffer:
    def __init__(self) -> None: ...
    def add_str(self, text: str, item_offset: int = ..., item_length: int = ...) -> None: ...
    def guess_segment_properties(self) -> None: ...
    @property
    def glyph_positions(self) -> list[GlyphPosition]: ...

def shape(font: Font, buffer: Buffer, features: Mapping[str, bool | int] | None = ...) -> None: ...
